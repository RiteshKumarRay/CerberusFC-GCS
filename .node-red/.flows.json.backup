    {
        "id": "cerb_builder",
        "type": "function",
        "z": "cerb_tab",
        "name": "Mission Builder",
        "func": "// 1. Get the payload safely\nlet p = msg.payload;\n\n// 2. Unwrap the nested object if Vue sent it\nif (p && p.payload) {\n    p = p.payload;\n}\n\n// 3. SILENT DROP FOR TELEMETRY (The Spam Fix!)\n// If the message is just telemetry passing through the dashboard, kill it quietly.\nif (p && p.type === 'telemetry') {\n    return null; \n}\n\n// Debug: Print to the sidebar ONLY if it's a real button click\nnode.warn(\"Mission Builder received command: \" + (p ? p.command : \"None\"));\n\n// Safety catch for any other weird data\nif (!p || !p.command) {\n    node.warn(\"Missing command! Message dropped.\");\n    return null;\n}\n\n// --- COMMAND ROUTING ---\n\nif (p.command === 'arm' || p.command === 'disarm' || p.command === 'rth') {\n    msg.payload = { command: p.command };\n    return msg;\n}\n\nif (p.command === 'clear') {\n    flow.set('drawnwaypoints', []);\n    msg.payload = { command: 'clear' }; \n    return msg;\n}\n\nif (p.command === 'upload') {\n    if (!p.waypoints || p.waypoints.length === 0) {\n        node.warn('No waypoints to upload.');\n        return null;\n    }\n\n    const built = p.waypoints.map((wp, i) => ({\n        index: i,\n        lat: parseFloat(wp.lat),\n        lon: parseFloat(wp.lon),\n        action: wp.action || 'waypoint',\n        altitude: parseInt(wp.altitude) || 20,\n        speed: parseInt(wp.speed) || 5,\n        loiter_time: parseInt(wp.loiter_time) || 0,\n        heading: parseInt(wp.heading) || -1,\n        radius: parseInt(wp.radius) || 10,\n        note: wp.note || ''\n    }));\n\n    msg.payload = { command: 'upload', waypoints: built };\n    node.warn('Uploading ' + built.length + ' waypoints');\n    return msg;\n}\n\nreturn null;",
