    {
        "id": "29b56582eca50769",
        "type": "function",
        "z": "cerb_tab",
        "name": "Live gps",
        "func": "try {\n    let telemetryData = JSON.parse(msg.payload);\n\n    if (!telemetryData.gps || !telemetryData.attitude) {\n        return null;\n    }\n\n    let lat = telemetryData.gps.lat;\n    let lon = telemetryData.gps.lon;\n    // Save the drone's live location to the flow memory\nflow.set('droneLat', lat);\nflow.set('droneLon', lon);\n    let currentHeading = telemetryData.attitude.yaw;\n\n    msg.payload = {\n        name: \"Cerberus\",\n        lat: lat,\n        lon: lon,\n\n        // Use a \"Special\" icon so the map knows it is allowed to rotate\n        // You can change \"arrow\" to \"quad\", \"uav\", or \"plane\"\n        icon: \"arrow\",\n\n        iconSize: 45,         // Makes the icon massive (size in pixels)\n        iconColor: \"#00FF00\", // Vibrant Neon Green\n\n        layer: \"Live Tracking\",\n\n        // This will now successfully grip the special icon and spin it!\n        heading: currentHeading\n    };\n\n    return msg;\n\n} catch (err) {\n    return null;\n}",
        "outputs": 1,
